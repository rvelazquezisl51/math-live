rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function realTeacher() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function gameDoc(code) { return get(/databases/$(database)/documents/games/$(code)); }
    function isTeacher(code) { return realTeacher() && gameDoc(code).data.teacherUid == request.auth.uid; }

    match /games/{gameCode} {
      allow create: if realTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.code == gameCode
                    && request.resource.data.status == 'lobby';
      // Students must read a game to validate a join code; teacher/TV also read it.
      allow read: if signedIn();
      allow update: if isTeacher(gameCode)
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && request.resource.data.code == resource.data.code;
      allow delete: if realTeacher() && resource.data.teacherUid == request.auth.uid;

      match /players/{playerId} {
        allow create: if signedIn()
                      && request.auth.token.firebase.sign_in_provider == 'anonymous'
                      && playerId == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.score == 0
                      && request.resource.data.answered == 0
                      && request.resource.data.finished == false
                      && gameDoc(gameCode).data.status == 'lobby';
        allow read: if signedIn() && (playerId == request.auth.uid || isTeacher(gameCode));
        allow update: if signedIn()
                      && request.auth.token.firebase.sign_in_provider == 'anonymous'
                      && playerId == request.auth.uid
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.name == resource.data.name
                      && request.resource.data.avatar == resource.data.avatar
                      && gameDoc(gameCode).data.status in ['playing','finished']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['score','answered','finished','lastSkill','lastStandard','lastLayer','evidence','diagnostic','finishedAt','unanswered','finishReason']);
        allow delete: if isTeacher(gameCode);
      }
    }
  }
}
